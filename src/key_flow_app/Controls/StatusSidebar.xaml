<UserControl x:Class="key_flow_app.Controls.StatusSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
  <Border Background="White" CornerRadius="10" Padding="14,12" Margin="0,0,0,12" BorderThickness="1">
    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#E8EBEF"/><Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="BorderBrush" Value="#007AFF"/></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="BorderBrush" Value="#248A3D"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Height="34" CornerRadius="2" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#8E8E93"/><Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="Background" Value="#007AFF"/></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#248A3D"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding StateText}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/></StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding SelectedProfile.Name}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" MaxWidth="170" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProfile.Name}"/>
    </Grid>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Content="▶  开始" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}" Height="46" Margin="0"/>
    <Button Grid.Column="2" Content="■  全部停止" Command="{Binding StopCommand}" Style="{StaticResource DestructiveButton}" Height="46" Margin="0"/>
  </Grid>
  <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
  <TextBlock Text="{Binding ActivationPoolStatus}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
</StackPanel></UserControl>
