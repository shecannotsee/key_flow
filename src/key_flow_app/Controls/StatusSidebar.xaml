<UserControl x:Class="key_flow_app.Controls.StatusSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
<Border CornerRadius="12" Padding="16" Margin="0,0,0,12">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E9EBEF"/><Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="Background" Value="#E5EEFF"/></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#DDF5E5"/></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Ellipse Width="14" Height="14" Margin="0,0,12,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#8E8E93"/><Style.Triggers><DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="Fill" Value="#007AFF"/></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="#248A3D"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding StateText}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
</Grid></Border>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Content="▶  开始" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}" Height="46" Margin="0"/>
<Button Grid.Column="2" Content="■  全部停止" Command="{Binding StopCommand}" Style="{StaticResource DestructiveButton}" Height="46" Margin="0"/>
</Grid>
<TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
</StackPanel></UserControl>
