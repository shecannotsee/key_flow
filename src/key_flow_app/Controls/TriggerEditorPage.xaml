<UserControl x:Class="key_flow_app.Controls.TriggerEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:key_flow_app.Controls">
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="什么时候执行" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <controls:HotkeyEditor/>
  <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CaptureText}" Value="按下主键；组合键请先按住 Ctrl、Alt 或 Shift"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border Background="#F6F8FB" CornerRadius="10" Padding="14" Margin="0,16,0,0">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile.ColorTriggerEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <StackPanel>
      <CheckBox Content="屏幕颜色激活时触发方案" IsChecked="{Binding SelectedProfile.ColorTriggerEnabled}"/>
      <TextBlock Text="开始按钮会进入监听。色块稳定地从未激活变为激活时，运行下一页配置的流程。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,10"/>
      <WrapPanel Margin="0,0,0,6">
        <Button Content="框选检测区域" Command="{Binding SelectColorRegionCommand}"/>
        <Button Content="采集激活颜色" Command="{Binding CaptureActiveColorCommand}"/>
        <Button Content="采集未激活颜色" Command="{Binding CaptureInactiveColorCommand}"/>
      </WrapPanel>
      <TextBlock Text="采样时会暂时收起本窗口；在目标状态出现时点击。框选/采样均可按 Esc 取消。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
      <WrapPanel Margin="0,10,0,6">
        <Button Content="检测当前区域" Command="{Binding TestColorCommand}"/>
        <TextBlock Text="确认时间" VerticalAlignment="Center" Margin="12,0,6,8"/>
        <TextBox Width="72" Text="{Binding SelectedProfile.TriggerDebounceMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
        <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,8"/>
      </WrapPanel>
      <WrapPanel>
        <TextBlock Text="激活色" VerticalAlignment="Center" Margin="0,0,6,8"/><TextBox Width="90" Margin="0,0,10,8" Text="{Binding SelectedProfile.ColorCondition.Target, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="未激活色" VerticalAlignment="Center" Margin="0,0,6,8"/><TextBox Width="90" Margin="0,0,10,8" Text="{Binding SelectedProfile.ColorCondition.InactiveTarget, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="容差" VerticalAlignment="Center" Margin="0,0,6,8"/><TextBox Width="54" Margin="0,0,0,8" Text="{Binding SelectedProfile.ColorCondition.Tolerance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
      </WrapPanel>
      <TextBlock Text="{Binding ColorStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,0"/>
    </StackPanel>
  </Border>
  <Expander Header="高级：每次按键前检查颜色" Margin="0,12,0,0">
    <CheckBox Content="仅颜色匹配时输出按键" IsChecked="{Binding SelectedProfile.ColorCondition.Enabled}" Margin="0,10"/>
  </Expander>
</StackPanel>
</UserControl>
