<UserControl x:Class="key_flow_app.Controls.ProfileSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#EFF8F2" BorderBrush="#CDE5D5" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="参与触发的方案" FontSize="15" FontWeight="SemiBold" Foreground="#24653D"/>
        <TextBlock Text="仅显示已激活配置组中已启用的方案。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,8"/>
        <TextBlock Text="暂无可触发方案。请激活配置组并启用方案。" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap">
          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasParticipatingProfiles}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding ParticipatingProfiles}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="White" CornerRadius="6" Padding="10,7" Margin="0,0,6,6">
                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#24653D" MaxWidth="230" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"><Run Text="触发键："/><Run Text="{Binding StartHotkey, Mode=OneWay}"/></TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F7F8FA" CornerRadius="12" Padding="14"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="配置组" FontSize="17" FontWeight="SemiBold"/><Button Content="＋ 新建配置组" Command="{Binding NewGroupCommand}" HorizontalAlignment="Left" Margin="0,10,0,12"/></StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8"><StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"><Run Text="{Binding MemberIds.Count, Mode=OneWay}"/><Run Text=" 个方案"/></TextBlock>
            <WrapPanel><Button Content="切换组激活" Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4"/><Button Content="编辑" Command="{Binding DataContext.EditGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4"/><Button Content="删除" Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" Foreground="{StaticResource DangerRed}"/></WrapPanel>
          </StackPanel></Border>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </DockPanel></Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="单个方案" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><ToggleButton x:Name="ManageToggle" Grid.Column="1" Content="管理配置" Padding="12,6" ToolTip="复制、导入、导出或删除配置">
        <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Background" Value="#F2F2F7"/><Setter Property="Foreground" Value="#505865"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
          <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#DDEAFF"/><Setter Property="Foreground" Value="#245BC5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers>
        </Style></ToggleButton.Style>
      </ToggleButton></Grid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ManageToggle}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
      <Button Content="复制所选" Command="{Binding DuplicateProfileCommand}"/><Button Content="导入" Command="{Binding ImportCommand}"/><Button Content="导出所选" Command="{Binding ExportCommand}"/><Button Content="删除所选" Command="{Binding DeleteProfileCommand}" Foreground="{StaticResource DangerRed}"/>
    </WrapPanel>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ProfileSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按方案名或分组搜索"/><TextBlock Text="⌕ 搜索方案" IsHitTestVisible="False" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ 新建方案" Command="{Binding UseVerifiedPresetCommand}"/><Button Content="保存全部" Command="{Binding SaveCommand}" Background="#EAF1FF" Foreground="#245BC5"/></StackPanel>
    <ListBox x:Name="ProfilesList" Grid.Row="1" Grid.ColumnSpan="2" IsEnabled="{Binding CanEdit}" SelectionChanged="ProfilesSelectionChanged" ItemsSource="{Binding FilteredProfiles}" SelectedItem="{Binding SelectedProfile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Margin="0,10,0,0">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="12,10"/>
        <Setter Property="Background" Value="#F7F8FA"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="#3478F6"/><Setter Property="Background" Value="#F0F5FF"/></Trigger></Style.Triggers>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,12,0"/>
          <Button Grid.Column="1" Command="{Binding DataContext.ToggleProfileEnabledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0" Padding="10,5">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="启用方案"/><Setter Property="Background" Value="#E9ECF1"/><Setter Property="Foreground" Value="#505865"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Content" Value="✓ 已启用"/><Setter Property="Background" Value="#DBEFE1"/><Setter Property="Foreground" Value="#24653D"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button Grid.Column="2" Content="删除" Margin="8,0,0,0" Foreground="{StaticResource DangerRed}" Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    </Grid>
    <Border Grid.Row="3" Background="#F0F5FF" CornerRadius="8" Padding="12" Margin="0,12,0,0">
      <StackPanel><TextBlock Foreground="#245BC5" TextWrapping="Wrap"><Run Text="当前选择："/><Run Text="{Binding SelectedProfileLabel, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
        <TextBlock Text="配置组决定是否参与监听，方案状态决定是否允许触发。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border></Grid>
  </Grid>
  </Grid>
</UserControl>
