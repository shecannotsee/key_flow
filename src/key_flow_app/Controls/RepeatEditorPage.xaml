<UserControl x:Class="key_flow_app.Controls.RepeatEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="流程重复规则" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="本规则作用于上一页的整个流程。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
  <RadioButton Content="持续重复，直到停止" IsChecked="{Binding IsUnlimitedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="unlimited" Margin="0,0,0,12"/>
  <RadioButton Content="限时重复，到时间自动停止" IsChecked="{Binding IsTimedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="timed"/>
  <WrapPanel Margin="26,10,0,12"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTimedMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,16,8"/>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="毫秒（0–999）" VerticalAlignment="Center" Margin="8,0,0,8"/>
  </WrapPanel>
  <Border Background="#F6F8FB" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="时间含义" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="重复间隔在“执行流程”页按步骤设置；限时长度控制整个流程运行多久。一次按键的按下时长由程序按当前短按设置处理。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
  </StackPanel></Border>
</StackPanel>
</UserControl>
