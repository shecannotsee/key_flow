<UserControl x:Class="key_flow_app.Controls.RepeatEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:key_flow_core;assembly=key_flow_core">
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock TextWrapping="Wrap" Text="流程重复规则" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
  <TextBlock TextWrapping="Wrap" Text="本规则作用于上一页的整个流程。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
  <RadioButton Content="持续重复，直到停止" IsChecked="{Binding IsUnlimitedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="unlimited" Margin="0,0,0,6"/>
  <RadioButton Content="限时重复，到时间自动停止" IsChecked="{Binding IsTimedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="timed"/>
  <WrapPanel Margin="26,10,0,12"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTimedMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock TextWrapping="Wrap" Text="秒" VerticalAlignment="Center" Margin="8,0,16,0"/>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock TextWrapping="Wrap" Text="毫秒（0–999）" VerticalAlignment="Center" Margin="8,0,0,0"/>
  </WrapPanel>
  <TextBlock TextWrapping="Wrap" Text="运行期间再次触发" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8"/>
  <TextBlock TextWrapping="Wrap" Text="单键开关模式下，再按一次就是停止；以下重复触发策略不生效。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseToggleHotkey}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseToggleHotkey}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <RadioButton Content="重新计时" IsChecked="{Binding ResetsOnRetrigger, Mode=OneWay}" Command="{Binding SetRetriggerCommand}" CommandParameter="reset"/>
    <TextBlock TextWrapping="Wrap" Text="从最后一次触发重新计算时长。5 秒任务在第 3 秒再次触发，将在第 8 秒结束。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="26,5,0,12"/>
    <RadioButton Content="忽略重复触发" IsChecked="{Binding IgnoresRetrigger, Mode=OneWay}" Command="{Binding SetRetriggerCommand}" CommandParameter="ignore"/>
    <TextBlock TextWrapping="Wrap" Text="保持原截止时间。5 秒任务在第 3 秒再次触发，仍在第 5 秒结束；按键继续传递。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="26,5,0,8"/>
    <TextBlock TextWrapping="Wrap" Text="持续重复没有截止时间：再次触发不会增加并行或排队任务。" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
  </StackPanel>
  <Expander Header="时间含义"><TextBlock TextWrapping="Wrap" Text="间隔从按键释放后计时，最后一个间隔后回到首键。限时控制整个流程的运行时长。" Style="{StaticResource HintText}" Margin="24,8,0,0"/></Expander>
</StackPanel>
</UserControl>
