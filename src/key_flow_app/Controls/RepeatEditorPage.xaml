<UserControl x:Class="key_flow_app.Controls.RepeatEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:key_flow_core;assembly=key_flow_core">
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="流程重复规则" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TextBlock Text="本规则作用于上一页的整个流程。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
  <RadioButton Content="持续重复，直到停止" IsChecked="{Binding IsUnlimitedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="unlimited" Margin="0,0,0,12"/>
  <RadioButton Content="限时重复，到时间自动停止" IsChecked="{Binding IsTimedMode, Mode=OneWay}" Command="{Binding SetRepeatModeCommand}" CommandParameter="timed"/>
  <WrapPanel Margin="26,10,0,12"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTimedMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,16,8"/>
    <TextBox Width="76" Text="{Binding SelectedProfile.DurationMilliseconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="毫秒（0–999）" VerticalAlignment="Center" Margin="8,0,0,8"/>
  </WrapPanel>
  <TextBlock Text="运行期间再次触发" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10"/>
  <TextBlock Text="单键开关模式下，再按一次就是停止；以下重复触发策略不生效。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UseToggleHotkey}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseToggleHotkey}" Value="True"><Setter Property="IsEnabled" Value="False"/><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <RadioButton Content="重新计时：最后一次触发后，再运行完整时长" IsChecked="{Binding ResetsOnRetrigger, Mode=OneWay}" Command="{Binding SetRetriggerCommand}" CommandParameter="reset"/>
    <TextBlock Text="例如限时 5 秒：第 3 秒再次触发，结束时间变为第 8 秒；不会另起一轮排队。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="26,5,0,12"/>
    <RadioButton Content="忽略重复触发：按原定时间结束" IsChecked="{Binding IgnoresRetrigger, Mode=OneWay}" Command="{Binding SetRetriggerCommand}" CommandParameter="ignore"/>
    <TextBlock Text="例如限时 5 秒：第 3 秒再次触发，仍在第 5 秒结束。原按键继续传给前台程序。" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="26,5,0,8"/>
    <TextBlock Text="持续重复没有截止时间：再次触发不会增加并行或排队任务。" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
  </StackPanel>
  <Border Background="#F6F8FB" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="时间含义" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="“执行流程”页的间隔表示按键释放后到下一键按下前的等待时间；最后一步间隔后回到首键。限时长度控制整个流程运行多久。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
  </StackPanel></Border>
</StackPanel>
</UserControl>
