<UserControl x:Class="key_flow_app.Controls.PreparationCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="White" BorderBrush="#C8DAFA" BorderThickness="1" CornerRadius="16" Padding="18">
    <StackPanel>
      <TextBlock Text="第一步" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}"/>
      <TextBlock Text="先准备，再开始" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,8"/>
      <TextBlock Text="点击下方按钮，完成后即可设置按键和开始使用。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
      <Button Content="{Binding InitializationText}" Command="{Binding InitializeCommand}" Style="{StaticResource PrimaryButton}" Height="50" FontSize="17" FontWeight="SemiBold" Margin="0" AutomationProperties.Name="准备使用"/>
      <TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
