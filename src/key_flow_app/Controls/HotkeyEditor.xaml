<UserControl x:Class="key_flow_app.Controls.HotkeyEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Padding="0">
<StackPanel>
  <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="快捷键" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Content="单键开关" IsChecked="{Binding UseToggleHotkey}" VerticalAlignment="Center" ToolTip="按一次开始，再按一次停止"/></Grid>
  <WrapPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,24,0"><TextBlock Text="{Binding StartHotkeyLabel}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/><Button Content="{Binding SelectedProfile.StartHotkey}" Command="{Binding CaptureStartCommand}" Style="{StaticResource KeyCaptureButton}" MinWidth="96" Margin="0" ToolTip="点击后录入，例如 Shift+1；先按住修饰键，再按主键"/></StackPanel>
    <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding UseToggleHotkey}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="停止" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/><Button Content="{Binding SelectedProfile.StopHotkey}" Command="{Binding CaptureStopCommand}" Style="{StaticResource KeyCaptureButton}" MinWidth="96" Margin="0" ToolTip="点击后录入，例如 Shift+1；先按住修饰键，再按主键"/></StackPanel>
  </WrapPanel>
</StackPanel>
</Border>
</UserControl>
