<UserControl x:Class="key_flow_app.Controls.WorkflowEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="执行什么流程" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <UniformGrid Columns="2" Margin="0,0,0,14">
    <RadioButton Content="单键重复" IsChecked="{Binding IsSingleKeyMode, Mode=OneWay}" Command="{Binding SetWorkflowModeCommand}" CommandParameter="single"/>
    <RadioButton Content="多个键顺序执行" IsChecked="{Binding IsSequenceMode, Mode=OneWay}" Command="{Binding SetWorkflowModeCommand}" CommandParameter="sequence"/>
  </UniformGrid>
  <TextBlock Text="只保留一个步骤，它会按重复规则循环。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSingleKeyMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <TextBlock Text="添加多个步骤，按列表顺序执行；整个列表作为一个流程重复。" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSequenceMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CaptureText}" Value="按下主键；组合键请先按住 Ctrl、Alt 或 Shift"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" Height="250" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFD" RowHeight="48" SelectionMode="Single" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Disabled">
    <DataGrid.Columns>
      <DataGridTemplateColumn Header="按键" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}" HorizontalAlignment="Left" MinWidth="100" Margin="8,6"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="重复间隔" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBox Text="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" HorizontalContentAlignment="Right"/><TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Margin="0,10,0,0"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSequenceMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="添加步骤" Command="{Binding AddStepCommand}"/><Button Content="删除步骤" Command="{Binding RemoveStepCommand}"/><Button Content="上移" Command="{Binding MoveStepUpCommand}"/><Button Content="下移" Command="{Binding MoveStepDownCommand}"/></WrapPanel>
</StackPanel>
</UserControl>
