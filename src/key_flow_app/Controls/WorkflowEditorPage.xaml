<UserControl x:Class="key_flow_app.Controls.WorkflowEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:key_flow_app.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/FluentTheme.xaml"/></ResourceDictionary.MergedDictionaries><local:StepNumberConverter x:Key="StepNumber"/></ResourceDictionary></UserControl.Resources>
<StackPanel IsEnabled="{Binding CanEdit}">
  <TextBlock Text="执行什么流程" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <UniformGrid Columns="2" Margin="0,0,0,8">
    <RadioButton Content="单键重复" IsChecked="{Binding IsSingleKeyMode, Mode=OneWay}" Command="{Binding SetWorkflowModeCommand}" CommandParameter="single"/>
    <RadioButton Content="多个键顺序执行" IsChecked="{Binding IsSequenceMode, Mode=OneWay}" Command="{Binding SetWorkflowModeCommand}" CommandParameter="sequence"/>
  </UniformGrid>
  <TextBlock Text="按键 → 等待 → 下一键。单键模式会重复同一个按键。" Style="{StaticResource HintText}"/>
  <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CaptureText}" Value="按下主键；组合键请先按住 Ctrl、Alt 或 Shift"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <WrapPanel Margin="0,0,0,8"><Button Margin="0,0,8,0" Content="添加步骤" Command="{Binding AddStepCommand}"/><Button Margin="0,0,8,0" Content="删除步骤" Command="{Binding RemoveStepCommand}"/><Button Margin="0,0,8,0" Content="上移" Command="{Binding MoveStepUpCommand}"/><Button Margin="0,0,8,0" Content="下移" Command="{Binding MoveStepDownCommand}"/></WrapPanel>
  <ListBox x:Name="StepsList" ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" AlternationCount="2147483647" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#E3EAF3" Background="#FBFCFE" CornerRadius="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF4FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#C9DCF7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#8EB6EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="66"/><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource StepNumber}}" VerticalAlignment="Center" Foreground="{StaticResource MainMuted}"/>
      <TextBlock Grid.Column="1" Text="按键" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}" Margin="0,0,8,0" ToolTip="点击后录入单键或组合键"/>
      <TextBlock Grid.Column="3" Text="按下并释放 · click" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
      <TextBlock Grid.Row="1" Text="↓" Foreground="{StaticResource MainMuted}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="等待" VerticalAlignment="Center"/>
      <TextBox Grid.Row="1" Grid.Column="2" Width="150" MinWidth="150" Margin="0,0,8,0" Text="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" HorizontalContentAlignment="Right" ToolTip="{Binding WaitAfterMs}" AutomationProperties.Name="到下一键的等待时间（毫秒）"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="毫秒，然后执行下一键" TextWrapping="Wrap" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock Text="↻ 最后一个等待结束后回到首键，直到限时结束或停止。" Style="{StaticResource HintText}" Margin="8,8,0,0"/>
</StackPanel>
</UserControl>
