<Window x:Class="key_flow_app.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:key_flow_app.Controls" Icon="Assets/key_flow.ico" Title="{Binding WindowTitle}" Topmost="{Binding IsPinned}" Width="500" Height="320" MinWidth="440" MinHeight="300" Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:HeaderBar/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <controls:PreparationCard VerticalAlignment="Top"/>
    </ScrollViewer>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
      <Border Background="{StaticResource SurfaceBackground}" CornerRadius="16" Padding="20"><StackPanel IsEnabled="{Binding CanEdit}"><controls:ProfileSelector/><Button Content="编辑所选方案" Command="{Binding OpenEditorCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
    </ScrollViewer>
    <controls:StatusSidebar Grid.Row="1" Margin="0,0,0,16">
      <controls:StatusSidebar.Style><Style TargetType="controls:StatusSidebar"><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:StatusSidebar.Style>
    </controls:StatusSidebar>
  </Grid>
</Window>
