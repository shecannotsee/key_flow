<UserControl x:Class="InputProbe.App.Controls.StatusSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/><TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource TextSecondary}" Margin="0,4,12,0"/><TextBlock Text="{Binding HotkeyStatus}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="开始" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}" MinWidth="80"/><Button Content="停止" Command="{Binding StopCommand}" Style="{StaticResource DestructiveButton}" Margin="0" MinWidth="80"/></StackPanel>
</Grid></UserControl>