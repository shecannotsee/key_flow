<UserControl x:Class="InputProbe.App.Controls.StatusSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="运行状态" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding StateText}" FontSize="22" Foreground="{StaticResource SuccessGreen}" Margin="0,14,0,4"/><TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource TextSecondary}"/></StackPanel></Border>
    <Border Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="18" Margin="0,16,0,0"><StackPanel><TextBlock Text="输入诊断" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="全局捕获：Windows Hook" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,4"/><TextBlock Text="Click 发送：按下后立即弹起" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/><TextBlock Text="目标窗口识别：已关闭" Foreground="{StaticResource SuccessGreen}"/><TextBlock Text="游戏响应：需要观察确认" Foreground="{StaticResource WarningOrange}" Margin="0,4,0,0"/></StackPanel></Border>
  </StackPanel>
</UserControl>
