<UserControl x:Class="InputProbe.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel IsEnabled="{Binding CanEdit}">
<TextBlock Text="配置" FontWeight="SemiBold" Margin="0,0,0,8"/>
<ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Padding="10,8" Margin="0,0,0,24"/>
<TextBlock Text="DD HID · 与命令行版共用输入内核" FontWeight="SemiBold" Margin="0,0,0,16"/>

<Button Content="新建数字 8 · 80ms" Command="{Binding UseVerifiedPresetCommand}" HorizontalAlignment="Left"/><TextBlock Text="快捷键" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="点击按键，再按下键盘上的一个键。" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="开始" Foreground="{StaticResource TextSecondary}"/><Button Content="{Binding SelectedProfile.StartHotkey}" Command="{Binding CaptureStartCommand}" Style="{StaticResource KeyCaptureButton}" Margin="0,6,0,0"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="停止" Foreground="{StaticResource TextSecondary}"/><Button Content="{Binding SelectedProfile.StopHotkey}" Command="{Binding CaptureStopCommand}" Style="{StaticResource KeyCaptureButton}" Margin="0,6,0,0"/></StackPanel></Grid>
<TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/>
<Border Height="1" Background="{StaticResource SurfaceSecondary}" Margin="0,16,0,20"/>
<TextBlock Text="执行顺序" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="从上到下持续循环。间隔是本次按下到下一步按下的时间；短于按住时长时，以按住时长为准。" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,12" TextWrapping="Wrap"/>
<DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F7F8FA" RowHeight="48" SelectionMode="Single" SelectionUnit="FullRow">
<DataGrid.Columns><DataGridTemplateColumn Header="按键 · 点击录入" Width="*" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}" Margin="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="按住 / 毫秒" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding HoldMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="1 至 60000 毫秒" Margin="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="间隔 / 毫秒" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="0 至 3600050 毫秒" Margin="6,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,14,0,0"><Button Content="＋ 添加" Command="{Binding AddStepCommand}"/><Button Content="删除" Command="{Binding RemoveStepCommand}"/><Button Content="↑ 上移" Command="{Binding MoveStepUpCommand}"/><Button Content="↓ 下移" Command="{Binding MoveStepDownCommand}" Margin="0"/></WrapPanel>
</StackPanel></UserControl>
