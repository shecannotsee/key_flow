<UserControl x:Class="InputProbe.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="当前配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProfile.Name}" FontSize="24" Margin="0,8,0,20"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始按键" Foreground="{StaticResource TextSecondary}"/><Button Content="{Binding SelectedProfile.StartHotkey}" Command="{Binding CaptureStartCommand}" Height="36" Margin="0,5,0,12" Style="{StaticResource KeyCaptureButton}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="结束按键" Foreground="{StaticResource TextSecondary}"/><Button Content="{Binding SelectedProfile.StopHotkey}" Command="{Binding CaptureStopCommand}" Height="36" Margin="0,5,0,12" Style="{StaticResource KeyCaptureButton}"/></StackPanel></Grid>
    <Border Background="{StaticResource SurfaceSecondary}" Padding="12" Margin="0,0,0,12"><TextBlock Text="目标窗口识别已关闭，程序启动后直接响应按键。" Foreground="{StaticResource TextSecondary}"/></Border>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox Content="循环执行" IsChecked="{Binding SelectedProfile.LoopEnabled}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.LoopIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,8,0"/><TextBlock Grid.Column="2" Text="ms / 轮" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/></Grid>
    <TextBlock Text="按键序列（Click）" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,6"/><DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" IsReadOnly="False" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTemplateColumn Header="按键（点击修改）" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="间隔 (ms)" Binding="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged}" Width="120"/></DataGrid.Columns></DataGrid>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="新增按键位" Command="{Binding AddStepCommand}"/><Button Content="删除选中" Command="{Binding RemoveStepCommand}"/><Button Content="上移" Command="{Binding MoveStepUpCommand}"/><Button Content="下移" Command="{Binding MoveStepDownCommand}" Margin="0"/></StackPanel>
    <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="启动按键" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="暂停" Command="{Binding PauseCommand}"/><Button Content="测试触发" Command="{Binding TriggerCommand}" Margin="0"/></StackPanel>
  </StackPanel>
</UserControl>
