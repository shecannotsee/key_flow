<UserControl x:Class="InputProbe.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="当前配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProfile.Name}" FontSize="24" Margin="0,8,0,20"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开始按键" Foreground="{StaticResource TextSecondary}"/><DockPanel Margin="0,5,0,12"><TextBox Text="{Binding SelectedProfile.StartHotkey, UpdateSourceTrigger=PropertyChanged}"/><Button DockPanel.Dock="Right" Content="录制" Command="{Binding CaptureStartCommand}" Margin="6,0,0,0"/></DockPanel></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="结束按键" Foreground="{StaticResource TextSecondary}"/><DockPanel Margin="0,5,0,12"><TextBox Text="{Binding SelectedProfile.StopHotkey, UpdateSourceTrigger=PropertyChanged}"/><Button DockPanel.Dock="Right" Content="录制" Command="{Binding CaptureStopCommand}" Margin="6,0,0,0"/></DockPanel></StackPanel></Grid>
    <TextBlock Text="目标进程" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding SelectedProfile.TargetProcess, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
    <TextBlock Text="按键序列" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,6"/><DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="按键" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="按下 (ms)" Binding="{Binding HoldMs, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="间隔 (ms)" Binding="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged}" Width="100"/></DataGrid.Columns></DataGrid>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="录制按键" Command="{Binding CaptureSequenceCommand}"/><Button Content="添加按键" Command="{Binding AddStepCommand}"/><Button Content="删除选中" Command="{Binding RemoveStepCommand}"/><Button Content="上移" Command="{Binding MoveStepUpCommand}"/><Button Content="下移" Command="{Binding MoveStepDownCommand}" Margin="0"/></StackPanel>
    <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="启动按键" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="暂停" Command="{Binding PauseCommand}"/><Button Content="测试触发" Command="{Binding TriggerCommand}" Margin="0"/></StackPanel>
  </StackPanel>
</UserControl>
