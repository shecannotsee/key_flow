<UserControl x:Class="InputProbe.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel IsEnabled="{Binding CanEdit}">
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="当前配置" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Padding="10,7" Margin="0,0,12,0"/></StackPanel>
    <Button Grid.Column="1" Content="＋ 新建" Command="{Binding UseVerifiedPresetCommand}" VerticalAlignment="Bottom" Margin="0"/>
  </Grid>
  <TextBlock Text="配置名称" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
  <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8"/>
  <WrapPanel Margin="0,0,0,14"><Button Content="复制配置" Command="{Binding DuplicateProfileCommand}"/><Button Content="删除配置" Command="{Binding DeleteProfileCommand}" ToolTip="删除当前配置，至少保留一个配置"/><Button Content="导入" Command="{Binding ImportCommand}"/><Button Content="导出当前配置" Command="{Binding ExportCommand}"/></WrapPanel>
  <Grid Margin="0,0,0,10"><TextBlock Text="重复列表" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="依次重复 · 直到停止" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}"/></Grid>
  <Border BorderBrush="#E8EBEF" BorderThickness="1" CornerRadius="10" Padding="4">
    <DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" Height="150" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFD" RowHeight="52" SelectionMode="Single" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#7A818C"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EEF3FC"/><Setter Property="Foreground" Value="#202734"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="按键" Width="*" MinWidth="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}" ToolTip="点击后按下要录入的键" HorizontalAlignment="Left" MinWidth="82" Margin="10,7"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="重复间隔" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBox Text="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" ToolTip="1 至 3600000 毫秒" HorizontalContentAlignment="Right"/><TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
  <WrapPanel Margin="0,10,0,14"><Button Content="＋ 添加按键" Command="{Binding AddStepCommand}"/><Button Content="删除" Command="{Binding RemoveStepCommand}"/><Button Content="↑" ToolTip="上移" Command="{Binding MoveStepUpCommand}"/><Button Content="↓" ToolTip="下移" Command="{Binding MoveStepDownCommand}" Margin="0"/></WrapPanel>
  <Border Height="1" Background="#ECEEF2" Margin="0,0,0,18"/>
  <TextBlock Text="快捷键" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="开始" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/><Button Grid.Column="1" Content="{Binding SelectedProfile.StartHotkey}" Command="{Binding CaptureStartCommand}" Style="{StaticResource KeyCaptureButton}" Width="90" Margin="0"/></Grid>
    <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="停止" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/><Button Grid.Column="1" Content="{Binding SelectedProfile.StopHotkey}" Command="{Binding CaptureStopCommand}" Style="{StaticResource KeyCaptureButton}" Width="90" Margin="0"/></Grid>
  </Grid>
  <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}" Margin="0,8,0,0"/>
</StackPanel>
</UserControl>
