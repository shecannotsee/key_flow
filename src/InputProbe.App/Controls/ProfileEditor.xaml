<UserControl x:Class="InputProbe.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="当前配置" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProfile.Name}" FontSize="24" Margin="0,8,0,20"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="触发键" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding SelectedProfile.Trigger, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="目标进程" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding SelectedProfile.TargetProcess, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/></StackPanel></Grid>
    <TextBlock Text="按键序列" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,6"/><ListView ItemsSource="{Binding SelectedProfile.Steps}" Height="220"><ListView.View><GridView><GridViewColumn Header="按键" DisplayMemberBinding="{Binding Key}" Width="140"/><GridViewColumn Header="按下 (ms)" DisplayMemberBinding="{Binding HoldMs}" Width="100"/><GridViewColumn Header="间隔 (ms)" DisplayMemberBinding="{Binding WaitAfterMs}" Width="100"/></GridView></ListView.View></ListView>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="启动按键" Command="{Binding ArmCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="暂停" Command="{Binding PauseCommand}"/><Button Content="测试触发" Command="{Binding TriggerCommand}" Margin="0"/></StackPanel>
  </StackPanel>
</UserControl>
