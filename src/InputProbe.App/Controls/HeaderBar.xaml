<UserControl x:Class="InputProbe.App.Controls.HeaderBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Input Probe" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="桌面按键控制台" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="保存配置" Command="{Binding SaveCommand}"/><Button Content="紧急停止" Command="{Binding StopCommand}" Style="{StaticResource DestructiveButton}" Margin="0"/></StackPanel>
  </Grid>
</UserControl>
