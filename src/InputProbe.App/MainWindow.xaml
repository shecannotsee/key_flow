<Window x:Class="InputProbe.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:InputProbe.App.Controls" Title="Input Probe" Width="820" Height="760" MinWidth="620" MinHeight="480" Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <controls:HeaderBar/>
