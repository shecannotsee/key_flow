<Window x:Class="InputProbe.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:InputProbe.App.Controls" Title="Input Probe" Width="1120" Height="720" MinWidth="900" MinHeight="620" Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <controls:HeaderBar/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="False">
      <Grid MinWidth="850"><Grid.ColumnDefinitions><ColumnDefinition Width="190" MinWidth="170"/><ColumnDefinition Width="*" MinWidth="430"/><ColumnDefinition Width="250" MinWidth="230"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="18" Margin="0,0,16,0"><controls:ProfileSidebar/></Border>
        <Border Grid.Column="1" Background="{StaticResource SurfaceBackground}" CornerRadius="12" Padding="24" Margin="0,0,16,0"><controls:ProfileEditor/></Border>
        <controls:StatusSidebar Grid.Column="2"/>
      </Grid>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="结束按键可随时停止  ·  当前不限制目标窗口  ·  标准输入模式" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,16,0,0"/>
  </Grid>
</Window>
