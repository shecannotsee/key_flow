<UserControl x:Class="KeyFlow.App.Controls.ProfileSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="我的配置" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ 新建" Command="{Binding UseVerifiedPresetCommand}"/><Button Content="保存配置" Command="{Binding SaveCommand}" Background="#EAF1FF" Foreground="#245BC5" Margin="0"/></StackPanel>
  </Grid>
  <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#F3F4F6"/><Setter Property="Foreground" Value="#505865"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDEAFF"/><Setter Property="Foreground" Value="#245BC5"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#DDEAFF"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="名称" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Background="#FAFBFD" BorderBrush="#E8EBEF"/></Grid>
  <Expander Header="管理配置" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0">
    <WrapPanel Margin="0,10,0,0"><Button Content="复制" Command="{Binding DuplicateProfileCommand}"/><Button Content="导入" Command="{Binding ImportCommand}"/><Button Content="导出" Command="{Binding ExportCommand}"/><Button Content="删除配置" Command="{Binding DeleteProfileCommand}" Foreground="{StaticResource DangerRed}" ToolTip="至少保留一个配置"/></WrapPanel>
  </Expander>
</StackPanel>
</UserControl>
