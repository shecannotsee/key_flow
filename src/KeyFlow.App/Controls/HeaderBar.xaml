<UserControl x:Class="KeyFlow.App.Controls.HeaderBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="/KeyFlow;component/Assets/KeyFlow.png" Width="48" Height="48" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="KeyFlow" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="重复按键" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <StackPanel IsEnabled="{Binding IsInitialized}" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsInitialized}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <ToggleButton IsChecked="{Binding IsPinned}" Padding="12,8" Margin="0" ToolTip="保持窗口置顶">
        <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="置顶"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E1E4E9"/><Setter Property="Foreground" Value="#505865"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#EAF1FF"/><Setter Property="BorderBrush" Value="#A6BFF0"/><Setter Property="Foreground" Value="#245BC5"/><Setter Property="Content" Value="已置顶"/></Trigger></Style.Triggers></Style></ToggleButton.Style>
      </ToggleButton>
    </StackPanel>
  </Grid>
</UserControl>
