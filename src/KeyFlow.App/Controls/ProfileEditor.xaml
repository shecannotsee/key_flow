<UserControl x:Class="KeyFlow.App.Controls.ProfileEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:KeyFlow.App.Controls">
<StackPanel IsEnabled="{Binding CanEdit}">
  <controls:ProfileSelector/>
  <controls:HotkeyEditor Margin="0,18,0,18"/>
  <controls:AutomationEditor Margin="0,0,0,18"/>
  <TextBlock Text="{Binding CaptureText}" Foreground="{StaticResource AccentBlue}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,10"/><Style.Triggers><DataTrigger Binding="{Binding CaptureText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Grid Margin="0,0,0,10"><TextBlock Text="按键序列" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="依次重复 · 按配置结束" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}"/></Grid>
  <Border BorderBrush="#E8EBEF" BorderThickness="1" CornerRadius="10" Padding="4">
    <DataGrid ItemsSource="{Binding SelectedProfile.Steps}" SelectedItem="{Binding SelectedStep}" Height="160" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFD" RowHeight="48" SelectionMode="Single" SelectionUnit="FullRow" HorizontalScrollBarVisibility="Disabled">
      <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#7A818C"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EEF3FC"/><Setter Property="Foreground" Value="#202734"/></Trigger></Style.Triggers></Style></DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="按键" Width="*" MinWidth="160" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Key}" Command="{Binding DataContext.CaptureSequenceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource KeyCaptureButton}" ToolTip="点击后录入单键或组合键，例如 Shift+1" HorizontalAlignment="Left" MinWidth="110" Margin="10,7"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="重复间隔" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBox Text="{Binding WaitAfterMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" ToolTip="1 至 3600000 毫秒" HorizontalContentAlignment="Right"/><TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Border>
  <WrapPanel Margin="0,10,0,0"><Button Content="＋ 添加按键" Command="{Binding AddStepCommand}"/><Button Content="删除" Command="{Binding RemoveStepCommand}"/><Button Content="↑" ToolTip="上移" Command="{Binding MoveStepUpCommand}"/><Button Content="↓" ToolTip="下移" Command="{Binding MoveStepDownCommand}" Margin="0"/></WrapPanel>
</StackPanel>
</UserControl>
